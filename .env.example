# cp .env.example .env
# Must match llm.model / llm.embed_model in config/agent.yaml (pulled by docker compose)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
DOCUMENTS_DIR=.docs/

# Ollama Cloud: read only when config/agent.yaml sets `llm.api_key_env: OLLAMA_API_KEY`.
# OLLAMA_API_KEY=         # https://ollama.com/settings/keys

# Web search: SearXNG (docker compose service) unless a SerpApi key is set.
# SEARXNG_SECRET=         # SearXNG secret key; a local-only default is used if unset
# SERPAPI_API_KEY=        # Google results via SerpApi instead of SearXNG
